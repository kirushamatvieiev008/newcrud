const $692e7a75cc0f9f37$export$50f8fd6af7856087 = (arr)=>{
    const students = arr.map((el)=>{
        return `<tr>
                    <th>${el.id}</th>
                    <th>${el.name}</th>
                    <th>${el.age}</th>
                    <th>${el.course}</th>
                    <th>${el.skills}</th>
                    <th>${el.email}</th>
                    <th>${el.isEnrolled ? 'enrolled' : 'not enrolled'}</th>
                    <th><button class="delete">delete</button><button class="change">change</button></th>
                </tr>`;
    }).join('');
    return students;
};


